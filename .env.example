# Copy to .env.local and fill in. Validated at runtime by src/lib/env.ts.

# Offline/mocked by default (ADR 0006). Set to "true" only when explicitly running live AI generation.
ALLOW_LIVE_AI_CALLS=false

# Server-only. Never expose with a NEXT_PUBLIC_ prefix. Required only when ALLOW_LIVE_AI_CALLS=true.
ELEVENLABS_API_KEY=
