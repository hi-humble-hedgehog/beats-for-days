# Copy to .env.local and fill in. Validated at runtime by src/lib/env.ts.

# Offline/mocked by default (ADR 0006). Set to "true" only when explicitly running live AI generation.
ALLOW_LIVE_AI_CALLS=false

# Server-only. Never expose with a NEXT_PUBLIC_ prefix. Required only when ALLOW_LIVE_AI_CALLS=true.
ELEVENLABS_API_KEY=

# Supabase (Local dev defaults from supabase start)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Audio asset delivery (ADR 0011): defaults to true in dev/test (public/audio/) and false in production (Supabase CDN).
USE_LOCAL_AUDIO=true

# Continuous playback seconds before resolving and arming the next transition
NEXT_PUBLIC_AUTO_TRANSITION_RESOLVE_SECONDS=30
