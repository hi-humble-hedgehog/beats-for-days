{
  "name": "beats-for-days",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "lefthook install",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "lint:a11y": "node .agents/skills/born-accessible-ui/scripts/lint.mjs --strict src/",
    "audit:a11y": "node .agents/skills/born-accessible-ui/scripts/audit.mjs http://localhost:3000/ http://localhost:3000/beat/01 http://localhost:3000/about http://localhost:3000/privacy --out reports/a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audio:convert": "tsx scripts/audio/convert.ts",
    "db:seed": "tsx scripts/seed/cli.ts",
    "crap": "tsx scripts/crap/cli.ts",
    "test:crap": "pnpm test:coverage && pnpm crap",
    "test:mutation": "next typegen && stryker run",
    "deps:check": "depcruise src scripts",
    "deps:graph": "depcruise src --output-type mermaid --output-to reports/dependency-graph.mmd",
    "knip": "knip",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:a11y && pnpm format:check && pnpm deps:check && pnpm knip && pnpm test:crap && pnpm test:e2e",
    "verify:full": "pnpm verify && pnpm test:mutation"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "happy-dom": "^21.0.4",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
